# Environment variables for the Netlify Functions in netlify/functions/.
#
# Copy to .env for local development (`netlify dev`), and set the same nine
# values in Netlify under Site configuration -> Environment variables.
#
# .env is gitignored. Never commit real values — this repository is PUBLIC.
#
# All nine are required. A missing variable does not fail the build; the
# affected function fails silently at runtime, so the site looks fine while
# signups, logins, purchases or the directory quietly stop working.

# ---------------------------------------------------------------------------
# Supabase — database and auth
# Used by: auth-login, auth-register, auth-verify, auth-forgot-password,
#          newsletter-subscribe, stripe-webhook
# ---------------------------------------------------------------------------

# Project URL. Public by design; also hardcoded in course/config.js.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon/public key. Safe to expose — it is already in course/config.js and
# relies on row-level security being ENABLED on every table.
SUPABASE_ANON_KEY=eyJhbGciOi...

# Service-role key. SECRET. Bypasses row-level security completely.
# Dashboard: Project Settings -> API Keys -> service_role
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# Stripe — course payments
# Used by: stripe-webhook
# ---------------------------------------------------------------------------

# Secret API key. Dashboard: Developers -> API keys
STRIPE_SECRET_KEY=sk_live_...

# Signing secret for the webhook endpoint. Tied to one specific endpoint URL,
# so it MUST be regenerated whenever the site URL changes. Create the endpoint
# at <site>/.netlify/functions/stripe-webhook subscribed to
# `checkout.session.completed`, then copy that endpoint's secret here.
# Verified at netlify/functions/stripe-webhook.js:21-24.
STRIPE_WEBHOOK_SECRET=whsec_...

# Price ID of the Catering Profit System course — NOT a payment link.
# stripe-webhook.js:45-48 matches it against the checkout session's line items
# to decide whether a payment grants course access. If this is wrong,
# customers are charged and receive nothing.
# Dashboard: Products -> the course -> its pricing row -> API ID
STRIPE_COURSE_PRICE_ID=price_...

# ---------------------------------------------------------------------------
# Resend — transactional email
# Used by: auth-register, auth-forgot-password, stripe-webhook
# ---------------------------------------------------------------------------

# API key. Shown once on creation — if lost, create a new one.
# The code sends from noreply@trecoleman.com, so that domain must be verified
# in Resend with live DKIM/SPF records or delivery fails despite a valid key.
RESEND_API_KEY=re_...

# ---------------------------------------------------------------------------
# Airtable — Virginia Neighbors directory
# Used by: airtable-proxy
# ---------------------------------------------------------------------------

# Personal access token. Shown once on creation.
# Needs read AND write scope on base appk7mBGffiWhowPC (table "Listings"),
# which is hardcoded at netlify/functions/airtable-proxy.js:3-4.
AIRTABLE_TOKEN=pat...

# ---------------------------------------------------------------------------
# Chat gate
# Used by: chat-auth
# ---------------------------------------------------------------------------

# Shared password for the premium AI chat. Self-chosen — nothing validates it
# against a previous value, so pick any strong string.
CHAT_PASSWORD=choose-a-strong-value
